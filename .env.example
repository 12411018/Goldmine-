# ============================================
# Goldmine AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.

# --- Backend ---
# Free provider (default routing is free-only; model IDs are fixed to :free endpoints)
OPENROUTER_API_KEY=your_openrouter_free_tier_api_key_here
FREE_MODELS_ONLY=true
HF_TOKEN=hf_your_huggingface_token_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
# Optional exact model ID for the separate synthesis pass; it must be distinct from candidate models.
SYNTHESIS_MODEL_ID=

# Prisma/PostgreSQL (Supabase connection strings)
DATABASE_URL=postgresql://user:password@host:6543/database?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/database

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Tavily web research API (opt-in per chat)
SEARCH_API_KEY=

# --- Frontend (prefix with VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_URL=http://localhost:8000
